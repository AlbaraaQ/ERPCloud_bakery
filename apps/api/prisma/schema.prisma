generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Tenant {
  id String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique
  status String @default("active") // active|suspended|readonly|deactivated
  baseCurrency String @default("SAR") @map("base_currency")
  timezone String @default("Asia/Riyadh")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  users User[]
  roles Role[]
  employees Employee[]
  auditLogs AuditLog[]
  sessions Session[]
  outbox OutboxEvent[]
  jobs BackgroundJob[]
  @@map("tenants")
}
model User {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  email String
  passwordHash String @map("password_hash")
  displayName String @map("display_name")
  status String @default("active")
  mfaSecret String? @map("mfa_secret")
  employeeId String? @unique @map("employee_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant Tenant @relation(fields:[tenantId], references:[id])
  employee Employee? @relation(fields:[employeeId], references:[id])
  roles UserRole[]
  sessions Session[]
  devices Device[]
  @@unique([tenantId, email])
  @@map("users")
}
model Employee {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  fullName String @map("full_name")
  status String @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant Tenant @relation(fields:[tenantId], references:[id])
  user User?
  @@map("employees")
}
model Role {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code String
  name String
  tenant Tenant @relation(fields:[tenantId], references:[id])
  users UserRole[]
  permissions RolePermission[]
  @@unique([tenantId, code])
  @@map("roles")
}
model Permission {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  roles RolePermission[]
  @@map("permissions")
}
model RolePermission {
  roleId String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  role Role @relation(fields:[roleId], references:[id], onDelete: Cascade)
  permission Permission @relation(fields:[permissionId], references:[id], onDelete: Cascade)
  @@id([roleId, permissionId])
  @@map("role_permissions")
}
model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user User @relation(fields:[userId], references:[id], onDelete: Cascade)
  role Role @relation(fields:[roleId], references:[id], onDelete: Cascade)
  @@id([userId, roleId])
  @@map("user_roles")
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash")
  refreshHash String @unique @map("refresh_hash")
  deviceId String? @map("device_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant Tenant @relation(fields:[tenantId], references:[id])
  user User @relation(fields:[userId], references:[id], onDelete: Cascade)
  @@map("sessions")
}
model Device {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  label String
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user User @relation(fields:[userId], references:[id], onDelete: Cascade)
  @@map("devices")
}
model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid
  action String
  entityType String @map("entity_type")
  entityId String? @map("entity_id")
  before Json?
  after Json?
  ip String?
  deviceId String? @map("device_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant Tenant? @relation(fields:[tenantId], references:[id])
  @@index([tenantId, createdAt])
  @@map("audit_log")
}
model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid
  type String
  payload Json
  status String @default("pending") // pending|processing|done|failed
  attempts Int @default(0)
  nextRetryAt DateTime? @map("next_retry_at") @db.Timestamptz(6)
  lastError String? @map("last_error")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant Tenant? @relation(fields:[tenantId], references:[id])
  @@index([status, nextRetryAt])
  @@map("outbox_events")
}
model BackgroundJob {
  id String @id @default(uuid()) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid
  type String
  payload Json
  status String @default("queued")
  attempts Int @default(0)
  maxAttempts Int @default(5) @map("max_attempts")
  nextRetryAt DateTime? @map("next_retry_at") @db.Timestamptz(6)
  lastError String? @map("last_error")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant Tenant? @relation(fields:[tenantId], references:[id])
  @@map("background_jobs")
}
model SubscriptionPlan {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  name String
  maxUsers Int @default(10) @map("max_users")
  maxRepresentatives Int @default(5) @map("max_representatives")
  features Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("subscription_plans")
}
model TenantSubscription {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid
  planId String @map("plan_id") @db.Uuid
  status String @default("active")
  renewsAt DateTime? @map("renews_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("tenant_subscriptions")
}

model AccountGroup {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code String
  name String
  type String // asset|liability|equity|revenue|expense
  accounts Account[]
  @@unique([tenantId, code])
  @@map("account_groups")
}
model Account {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  groupId String? @map("group_id") @db.Uuid
  code String
  name String
  type String
  isActive Boolean @default(true) @map("is_active")
  group AccountGroup? @relation(fields: [groupId], references: [id])
  lines JournalLine[]
  @@unique([tenantId, code])
  @@map("accounts")
}
model AccountMapping {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  purpose String // SALES_REVENUE, INVENTORY, COGS, VAT_OUTPUT, ...
  accountId String @map("account_id") @db.Uuid
  @@unique([tenantId, purpose])
  @@map("account_mappings")
}
model FiscalYear {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name String
  startDate DateTime @map("start_date") @db.Date
  endDate DateTime @map("end_date") @db.Date
  periods AccountingPeriod[]
  @@map("fiscal_years")
}
model AccountingPeriod {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  fiscalYearId String @map("fiscal_year_id") @db.Uuid
  name String
  startDate DateTime @map("start_date") @db.Date
  endDate DateTime @map("end_date") @db.Date
  status String @default("open") // open|closed
  closedBy String? @map("closed_by") @db.Uuid
  closedAt DateTime? @map("closed_at") @db.Timestamptz(6)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id])
  @@map("accounting_periods")
}
model DocumentSequence {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  docType String @map("doc_type")
  scope String @default("")
  lastNumber Int @default(0) @map("last_number")
  @@unique([tenantId, docType, scope])
  @@map("document_sequences")
}
model JournalEntry {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  number Int?
  businessDate DateTime @map("business_date") @db.Date
  description String?
  status String @default("posted") // draft|posted|reversed
  sourceType String? @map("source_type")
  sourceId String? @map("source_id")
  idempotencyKey String? @map("idempotency_key")
  reversalOfId String? @unique @map("reversal_of_id") @db.Uuid
  createdBy String? @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lines JournalLine[]
  reversalOf JournalEntry? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy JournalEntry? @relation("Reversal")
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, businessDate])
  @@map("journal_entries")
}
model JournalLine {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  entryId String @map("entry_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid
  debit Decimal @default(0) @db.Decimal(19, 4)
  credit Decimal @default(0) @db.Decimal(19, 4)
  branchId String? @map("branch_id") @db.Uuid
  warehouseId String? @map("warehouse_id") @db.Uuid
  representativeId String? @map("representative_id") @db.Uuid
  costCenter String? @map("cost_center")
  partyId String? @map("party_id") @db.Uuid
  entry JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])
  @@map("journal_lines")
}
model UnitOfMeasure {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code String
  name String
  @@unique([tenantId, code])
  @@map("units_of_measure")
}
model Product {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  sku String
  barcode String?
  nameAr String @map("name_ar")
  nameEn String? @map("name_en")
  stockUnitId String @map("stock_unit_id") @db.Uuid
  costingMethod String @default("moving_average") @map("costing_method")
  lotTracked Boolean @default(false) @map("lot_tracked")
  expiryTracked Boolean @default(false) @map("expiry_tracked")
  isActive Boolean @default(true) @map("is_active")
  taxCategory String? @map("tax_category")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  units ProductUnit[]
  movements StockMovement[]
  balances StockBalance[]
  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@map("products")
}
model ProductUnit {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  unitId String @map("unit_id") @db.Uuid
  factorToStock Decimal @map("factor_to_stock") @db.Decimal(19, 6)
  kind String // purchase|sales|stock
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([tenantId, productId, unitId, kind])
  @@map("product_units")
}
model Warehouse {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code String
  name String
  kind String @default("main") // main|branch|representative|quarantine|damaged
  employeeId String? @unique @map("employee_id") @db.Uuid
  isActive Boolean @default(true) @map("is_active")
  movements StockMovement[]
  balances StockBalance[]
  @@unique([tenantId, code])
  @@map("warehouses")
}
model Lot {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  code String
  expiryDate DateTime? @map("expiry_date") @db.Date
  @@unique([tenantId, productId, code])
  @@map("lots")
}
model StockMovement {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid
  lotId String? @map("lot_id") @db.Uuid
  type String
  qty Decimal @db.Decimal(19, 6) // signed, in stock unit
  unitCost Decimal @map("unit_cost") @db.Decimal(19, 4)
  value Decimal @db.Decimal(19, 4)
  sourceType String @map("source_type")
  sourceId String @map("source_id")
  idempotencyKey String? @map("idempotency_key")
  businessDate DateTime @map("business_date") @db.Date
  createdBy String? @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product Product @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, productId, warehouseId])
  @@map("stock_movements")
}
model StockBalance {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid
  lotId String? @map("lot_id") @db.Uuid
  qty Decimal @default(0) @db.Decimal(19, 6)
  value Decimal @default(0) @db.Decimal(19, 4)
  avgCost Decimal @default(0) @map("avg_cost") @db.Decimal(19, 4)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  product Product @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  @@unique([tenantId, productId, warehouseId, lotId])
  @@map("stock_balances")
}
