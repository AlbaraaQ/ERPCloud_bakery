# Copy to apps/api/.env for LOCAL (non-Docker) runs — Prisma reads THIS file.
# Without it you get:  P1012 Environment variable not found: DATABASE_URL
DATABASE_URL=postgresql://erp:erp@localhost:5432/erpcloud?schema=public
PORT=3001
NODE_ENV=development
SESSION_SECRET=change-me-in-production-min-32-chars
WEB_ORIGIN=http://localhost:5173
# Optional, only when testing backups / tax / AI locally:
# BACKUP_ENCRYPTION_KEY=at-least-32-random-characters
# BACKUP_DIR=/tmp/erpcloud-backups
# SEED_OWNER_PASSWORD= (used by: npm run seed)
