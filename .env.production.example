# ============================================================
# ERPCloud — Production environment template
# Copy to ".env.production" and fill EVERY value. Never commit the real file.
# Generate secrets with:  openssl rand -hex 32
# ============================================================

# --- Database (owner account: only used by the one-shot migrate service) ---
POSTGRES_USER=erp_owner
POSTGRES_PASSWORD=CHANGE_ME_STRONG_OWNER_PASSWORD
POSTGRES_DB=erpcloud

# --- Application DB account (non-owner; Row-Level Security applies to it) ---
# The migrate service creates/updates this role from apps/api/prisma/app-role.sql
APP_DB_USER=erp_app
APP_DB_PASSWORD=CHANGE_ME_STRONG_APP_PASSWORD

# --- API ---
NODE_ENV=production
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
# Public origin of the web app, e.g. https://erp.example.com
WEB_ORIGIN=https://erp.example.com
API_PORT=3001

# --- Backups (encrypted logical export; artifact must verify before it counts) ---
BACKUP_ENCRYPTION_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
BACKUP_DIR=/var/backups/erpcloud

# --- First tenant seed (runs only when RUN_SEED=true on first boot) ---
RUN_SEED=false
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=CHANGE_ME_STRONG_OWNER_LOGIN_PASSWORD

# --- Optional: ZATCA (leave empty to keep tax submission DISABLED) ---
# Production submission must stay disabled until sandbox onboarding + legal
# sign-off are complete (see docs/RELEASE_READINESS.md, Q-001/Q-002/Q-003).
ZATCA_BASE_URL=
ZATCA_CLEARANCE_PATH=
ZATCA_REPORTING_PATH=

# --- Optional: Google Drive backup target (deployment OAuth credentials) ---
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_TOKEN_SECRET_REF=

# --- Optional: AI assistant provider (key referenced by env NAME, never stored in DB) ---
# AI_PROVIDER_API_KEY=
